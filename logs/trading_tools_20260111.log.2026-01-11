2026-01-11 15:14:19 [DEBUG] trading_tools.db: SQL execute: 
            SELECT 
                s.id as isin_id,
                s.name,
                s.ticker,
                -- Shares sold (sum of all SELL trades in date range)
                SUM(ABS(st.number_of_shares)) as shares_sold,
                -- Shares paired (sum of all pairings for these sales)
                COALESCE(SUM(p.quantity), 0) as shares_paired,
                -- Buy cost (sum of purchase cost per share * paired quantity)
                COALESCE(SUM(
                    (ABS(pt.total_czk) / ABS(pt.number_of_shares)) * p.quantity
                ), 0) as total_buy_cost,
                -- Sell proceeds (sum of sale proceeds per share * paired quantity)
                COALESCE(SUM(
                    (ABS(st.total_czk) / ABS(st.number_of_shares)) * p.quantity
                ), 0) as total_sell_proceeds,
                -- Realized P&L (sell proceeds - buy cost)
                COALESCE(SUM(
                    ((ABS(st.total_czk) / ABS(st.number_of_shares)) - 
                     (ABS(pt.total_czk) / ABS(pt.number_of_shares))) * p.quantity
                ), 0) as realized_pnl,
                -- Buy side taxes (proportional to paired quantity)
                COALESCE(SUM(ABS(pt.conversion_fee_czk) * p.quantity / ABS(pt.number_of_shares)), 0) as buy_conversion_fee,
                COALESCE(SUM(ABS(pt.stamp_tax_czk) * p.quantity / ABS(pt.number_of_shares)), 0) as buy_stamp_tax,
                COALESCE(SUM(ABS(pt.french_transaction_tax_czk) * p.quantity / ABS(pt.number_of_shares)), 0) as buy_french_tax,
                -- Sell side taxes (proportional to paired quantity)
                COALESCE(SUM(ABS(st.conversion_fee_czk) * p.quantity / ABS(st.number_of_shares)), 0) as sell_conversion_fee,
                COALESCE(SUM(ABS(st.stamp_tax_czk) * p.quantity / ABS(st.number_of_shares)), 0) as sell_stamp_tax,
                COALESCE(SUM(ABS(st.french_transaction_tax_czk) * p.quantity / ABS(st.number_of_shares)), 0) as sell_french_tax
            FROM trades st
            JOIN securities s ON st.isin_id = s.id
            LEFT JOIN pairings p ON st.id = p.sale_trade_id
            LEFT JOIN trades pt ON p.purchase_trade_id = pt.id
            WHERE st.trade_type = ?
            AND st.timestamp >= ?
            AND st.timestamp <= ?
            GROUP BY s.id, s.name, s.ticker
            ORDER BY s.name COLLATE NOCASE
         -- (<TradeType.SELL: 2>, 1672527600, 1704063599)
