                CASE 
                    WHEN ABS(SUM(t.number_of_shares)) > 1e-10
                    THEN SUM(t.total_czk) / SUM(t.number_of_shares)
                    ELSE 0 
                END as avg_price,
                MIN(t.timestamp) as earliest_date,
                MAX(t.timestamp) as latest_date
